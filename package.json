{
  "name": "boompuff",
  "version": "11.0.0",
  "private": true,
  "description": "BOOMPUFF — HTML5 Canvas topçu düellosu; Capacitor ile Android paketlemesi",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "fonts": "powershell -ExecutionPolicy Bypass -File tools/fetch-fonts.ps1",
    "assets": "npx --yes @capacitor/assets@3 generate --android --iconBackgroundColor #16206e --splashBackgroundColor #0b1630",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npx cap sync android && cd android && gradlew assembleDebug",
    "android:release": "npx cap sync android && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
